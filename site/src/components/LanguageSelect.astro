---
import DefaultLanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';

// Generated API pages have canonical English routes and no translated counterparts.
const id = Astro.locals.starlightRoute.id;
const isAPIReference = id === 'reference/api' || id.startsWith('reference/api/');
const isNotFound = Astro.locals.starlightRoute.entry.id.split('/').at(-1) === '404';
---

{!isAPIReference && !isNotFound && <DefaultLanguageSelect />}
