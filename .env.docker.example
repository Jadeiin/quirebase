# Configuration for docker-compose.yml. Create it with `make docker-env`, which copies
# this example and appends a generated POSTGRES_PASSWORD, then edit the values below.

# Required by the bundled PostgreSQL service. `make docker-env` fills this in.
# POSTGRES_PASSWORD=

# Compose controls.
QUIREBASE_IMAGE_TAG=latest
QUIREBASE_PORT=9060

# Public hostname(s) of the deployment, comma separated. Set these before exposing the
# service and enable secure cookies once TLS terminates in front of the published port.
QUIREBASE_ALLOWED_HOSTS=localhost,127.0.0.1
QUIREBASE_SECURE_COOKIES=false

# Browser-based MCP clients must be explicitly allowlisted; native clients send no Origin.
# QUIREBASE_MCP_ALLOWED_ORIGINS=https://research-client.example,http://localhost:4310

# Recommended identification for Crossref and NCBI polite API access.
# INQUIRO_CONTACT_EMAIL=admin@example.org
# Optional provider API keys.
# INQUIRO_NCBI_API_KEY=
# INQUIRO_OPENALEX_API_KEY=
# INQUIRO_NASA_ADS_TOKEN=
# INQUIRO_IEEE_API_KEY=

# Object data plane: the shared local volume by default. The bundled single-node Garage
# deployment (`make docker-up-s3` with docker-compose.s3.yml) reads the settings below and
# defaults to its own service; external S3-compatible services also work.
# QUIREBASE_OBJECT_STORE=s3
# QUIREBASE_S3_BUCKET=quirebase
# QUIREBASE_S3_REGION=us-east-1
# QUIREBASE_S3_ENDPOINT=http://garage:3900
# QUIREBASE_S3_PREFIX=production
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Worker identity. Unset derives a distinct ID per container so replicas can scale
# safely; pin a stable value to let a single worker resume its own workflows after
# its container is recreated.
# QUIREBASE_WORKFLOW_EXECUTOR_ID=quirebase-worker

# Default offline Tag Recommendation engine. This image includes the YAKE engine;
# the semantic keybert engine requires a custom image built with the keybert extra.
# QUIREBASE_RECOMMENDATION_ENGINE=yake
