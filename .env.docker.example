# Configuration for docker-compose.yml. Create it with `make docker-env`, which copies
# this example and appends a generated POSTGRES_PASSWORD, then edit the values below.

# Required by the bundled PostgreSQL service. `make docker-env` fills this in with a
# generated hexadecimal password, which is safe inside the default database URL. If you
# set a password with URL-reserved characters (@, :, /, %), either percent-encode it in
# QUIREBASE_DATABASE_URL below or point QUIREBASE_DATABASE_URL at another database.
# POSTGRES_PASSWORD=

# Compose controls.
QUIREBASE_IMAGE_TAG=latest
QUIREBASE_PORT=9060
# The published web port binds loopback by default so the service is not exposed on the
# network. Set a host IP (or 0.0.0.0) only when a reverse proxy or load balancer cannot
# reach 127.0.0.1, and keep TLS termination in front of it.
QUIREBASE_BIND_ADDRESS=127.0.0.1

# The bundled PostgreSQL service is wired into QUIREBASE_DATABASE_URL automatically.
# Override it to use an external database or a percent-encoded password:
# QUIREBASE_DATABASE_URL=postgresql://quirebase:encoded-password@postgres:5432/quirebase

# Public hostname(s) of the deployment, comma separated. Set these before exposing the
# service and enable secure cookies once TLS terminates in front of the published port.
QUIREBASE_ALLOWED_HOSTS=localhost,127.0.0.1
# QUIREBASE_EXTERNAL_ORIGIN=https://library.example
QUIREBASE_SECURE_COOKIES=false

# Browser-based MCP clients must be explicitly allowlisted; native clients send no Origin.
# QUIREBASE_MCP_ALLOWED_ORIGINS=https://research-client.example,http://localhost:4310

# Recommended identification for Crossref and NCBI polite API access.
# INQUIRO_CONTACT_EMAIL=admin@example.org
# Optional provider API keys.
# INQUIRO_NCBI_API_KEY=
# INQUIRO_OPENALEX_API_KEY=
# INQUIRO_NASA_ADS_TOKEN=
# INQUIRO_IEEE_API_KEY=

# Object data plane: the shared local volume by default. The settings below configure the
# base compose file, so they cover external S3-compatible services and the shared volume.
# The bundled single-node Garage variant (`make docker-up-s3` with docker-compose.s3.yml)
# pins its region to the us-east-1 in docker/garage.toml, because Garage only reads the
# region from that file.
# QUIREBASE_OBJECT_STORE=s3
# QUIREBASE_S3_BUCKET=quirebase
# QUIREBASE_S3_REGION=us-east-1
# QUIREBASE_S3_ENDPOINT=https://s3.example.com
# QUIREBASE_S3_PREFIX=production
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Worker identity. The default is stable, so a recreated worker resumes its own
# in-flight workflows automatically. To run several workers, add one worker service per
# replica in a compose override and give each a distinct value (see docs/DEPLOYMENT.md).
# QUIREBASE_WORKFLOW_EXECUTOR_ID=quirebase-worker

# Default offline Tag Recommendation engine. This image includes the YAKE engine;
# the semantic keybert engine requires a custom image built with the keybert extra.
# QUIREBASE_RECOMMENDATION_ENGINE=yake
