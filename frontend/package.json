{
	"name": "@quirebase/frontend",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run i18n:compile && vite dev",
		"build": "bun run i18n:compile && vite build",
		"bundle:check": "bun run scripts/check-bundle-budget.ts",
		"styling:check": "bun run scripts/check-styling.ts",
		"api:generate": "uv run python ../scripts/export-openapi.py openapi.json && openapi-typescript openapi.json -o src/lib/api/schema.d.ts && prettier --write src/lib/api/schema.d.ts",
		"api:check": "bun run api:generate && git diff --exit-code -- src/lib/api/schema.d.ts",
		"check": "bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && bun run styling:check",
		"i18n:extract": "lingui extract --clean --overwrite",
		"i18n:template": "lingui extract-template",
		"i18n:compile": "lingui compile --typescript",
		"i18n:watch": "lingui compile --typescript --watch",
		"i18n:check": "lingui extract --clean --overwrite && lingui compile --typescript",
		"test": "bun run i18n:compile && vitest run",
		"test:e2e": "playwright test",
		"test:e2e:fullstack": "playwright test --config playwright.fullstack.config.ts",
		"lint": "prettier --check . && eslint --max-warnings 0 .",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@cfworker/json-schema": "4.1.1",
		"@embedpdf/models": "2.15.0",
		"@embedpdf/pdfium": "2.15.0",
		"@embedpdf/svelte-pdf-viewer": "2.15.0",
		"@lingui/core": "^6.9.1",
		"@lingui/detect-locale": "^6.9.1",
		"@sjsf/cfworker-validator": "3.9.0",
		"@sjsf/form": "3.9.0",
		"@sjsf/skeleton5-theme": "3.9.0",
		"@skeletonlabs/skeleton": "5.0.1",
		"@skeletonlabs/skeleton-svelte": "5.0.1",
		"@tanstack/svelte-query": "^6.3.3",
		"@tanstack/svelte-table": "9.3.1",
		"openapi-fetch": "^0.17.0",
		"svelte": "^5.57.2",
		"temml": "0.13.5"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@lingui/cli": "^6.9.1",
		"@lingui/format-po": "^6.9.1",
		"@playwright/test": "^1.64.1",
		"@shadcn/lint": "^0.2.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-lingui": "^0.16.0",
		"eslint-plugin-svelte": "^3.23.1",
		"eslint-plugin-tailwindcss": "^4.4.0",
		"globals": "^17.13.0",
		"jsdom": "~30.0.1",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22.17"
	}
}
