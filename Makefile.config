# Quirebase Makefile configuration

# Host & Ports
export HOST ?= 127.0.0.1
export PORT ?= 9060
export DEV_USERNAME ?= admin
export DEV_PASSWORD ?= quirebase-dev

# Virtualenv & Tools
VENV = $(CURDIR)/.venv
PYTHON = $(VENV)/bin/python
UV ?= uv
BUN ?= bun
PYBABEL = $(UV) run pybabel
RUFF = $(UV) run ruff
MYPY = $(UV) run mypy
PYTEST = $(UV) run pytest
QUIREBASE = $(UV) run quirebase

# Containers (Docker or Podman); override with CONTAINER_ENGINE=podman or COMPOSE=...
CONTAINER_ENGINE ?= $(if $(shell command -v docker 2>/dev/null),docker,podman)
COMPOSE ?= $(CONTAINER_ENGINE) compose
export DOCKER_ENV ?= .env.docker
ADMIN_USERNAME ?= admin

# Paths
SRC_DIR = src/quirebase
LOCALES_DIR = $(SRC_DIR)/locales
POT_FILE = $(LOCALES_DIR)/messages.pot
BABEL_CFG = babel.cfg
DEFAULT_LANG ?= zh_CN

# Database / Storage Defaults for Dev
export QUIREBASE_DEV_HOST = $(HOST)
export QUIREBASE_DEV_PORT = $(PORT)
export QUIREBASE_DEV_USERNAME = $(DEV_USERNAME)
export QUIREBASE_DEV_PASSWORD = $(DEV_PASSWORD)
