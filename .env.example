QUIREBASE_DATABASE_URL=sqlite:///./quirebase.db
QUIREBASE_DATA_DIR=./quirebase-data
QUIREBASE_SECURE_COOKIES=false
QUIREBASE_MAX_PDF_BYTES=262144000
QUIREBASE_ALLOWED_HOSTS=localhost,127.0.0.1
# Default offline Tag Recommendation engine:
QUIREBASE_RECOMMENDATION_ENGINE=yake
# Optional semantic engine (install quirebase[keybert]); this must be a local directory.
# QUIREBASE_RECOMMENDATION_ENGINE=keybert
# QUIREBASE_KEYBERT_MODEL_PATH=/srv/quirebase/models/model2vec
# Record the model license separately and pin its directory-content checksum:
# QUIREBASE_KEYBERT_MODEL_SHA256=
# Required before other users access the service over a network:
# QUIREBASE_SOURCE_URL=https://example.org/source/quirebase-v0.1.0.tar.gz
# Recommended identification for Crossref and NCBI polite API access:
# QUIREBASE_METADATA_CONTACT_EMAIL=admin@example.org
# Optional higher NCBI request quota:
# QUIREBASE_NCBI_API_KEY=
# Optional higher OpenAlex request budget and usage tracking:
# QUIREBASE_OPENALEX_API_KEY=
# Optional NASA ADS search (free token from https://ui.adsabs.harvard.edu/#user/settings/token):
# QUIREBASE_NASA_ADS_TOKEN=
# Optional IEEE Xplore search (free key from https://developer.ieee.org):
# QUIREBASE_IEEE_API_KEY=
